      "kind": "chip",
      "refersTo": "badge",
      "description": "Verdict pills: solid hue on its own wash.",
      "html": "<span class=\"ds-badge\">synthetic</span> <span class=\"ds-badge ds-good\">held</span> <span class=\"ds-badge ds-bad\">fell</span> <span class=\"ds-badge ds-warn\">attested</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;font:600 .78rem \"Segoe UI Variable Text\",system-ui,sans-serif;padding:3px 10px;border-radius:999px;background:var(--card-2,#f0f2f5);color:var(--ink-2,#4d5560)}.ds-good{background:var(--good-bg,#e1f4e9);color:var(--good,#187d43)}.ds-bad{background:var(--bad-bg,#fbe5e5);color:var(--bad,#c53232)}.ds-warn{background:var(--warn-bg,#fcf1dd);color:var(--warn,#976419)}"
    },
    {
      "name": "Play button",
      "kind": "button",
      "refersTo": "button-play",
      "description": "The one filled action: starts a page's authored moment.",
      "html": "<button class=\"ds-play\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M8 5.8v12.4a.6.6 0 0 0 .9.5l10-6.2a.6.6 0 0 0 0-1l-10-6.2a.6.6 0 0 0-.9.5z\" fill=\"currentColor\"/></svg>Run the crawl</button>",
      "css": ".ds-play{display:inline-flex;align-items:center;gap:7px;font:700 1rem \"Segoe UI Variable Text\",system-ui,sans-serif;padding:9px 18px;border-radius:999px;border:none;background:var(--ours,#266ec4);color:#fff;cursor:pointer;box-shadow:0 1px 2px rgba(16,20,26,.05),0 6px 20px -8px rgba(16,20,26,.12);transition:transform .12s}.ds-play:hover{transform:translateY(-1px)}.ds-play:focus-visible{outline:2px solid var(--ours,#266ec4);outline-offset:2px}.ds-play:disabled{opacity:.55;cursor:default;transform:none}"
    },
