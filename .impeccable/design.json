  "components": [
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "The instrument: every content block sits on one.",
      "html": "<div class=\"ds-card\"><h2 class=\"ds-card-h\">Fields pulled</h2><p class=\"ds-card-p\">Only what the purpose needs.</p></div>",
      "css": ".ds-card{background:var(--card,#fff);color:var(--ink,#121417);border-radius:14px;padding:16px;box-shadow:0 1px 2px rgba(16,20,26,.05),0 6px 20px -8px rgba(16,20,26,.12);font-family:\"Segoe UI Variable Text\",system-ui,sans-serif;max-width:320px}.ds-card-h{font-family:\"Segoe UI Variable Display\",system-ui,sans-serif;font-size:1.08rem;font-weight:650;letter-spacing:-0.01em;margin:0 0 6px}.ds-card-p{margin:0;color:var(--ink-2,#4d5560)}"
    },
    {
      "name": "Hero number",
      "kind": "custom",
      "refersTo": "hero-number",
      "description": "Funnel tile: a large tabular number in its owner's hue over a short label; counts up on arrival.",
      "html": "<div class=\"ds-fn\"><div class=\"ds-fn-v\">32</div><div class=\"ds-fn-l\">page loads · ours</div></div>",
      "css": ".ds-fn{background:var(--card,#fff);border-radius:14px;padding:12px 14px 11px;box-shadow:0 1px 2px rgba(16,20,26,.05),0 6px 20px -8px rgba(16,20,26,.12);width:180px;font-family:\"Segoe UI Variable Text\",system-ui,sans-serif}.ds-fn-v{font-family:\"Segoe UI Variable Display\",system-ui,sans-serif;font-size:2.1rem;font-weight:700;letter-spacing:-0.03em;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--ours,#266ec4)}.ds-fn-l{font-size:.74rem;font-weight:600;color:var(--ink-2,#4d5560);margin-top:3px}"
    },
    {
      "name": "Site navigation",
      "kind": "nav",
      "refersTo": "sitenav",
      "description": "One pill bar per page; the current page inverts to ink.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\">Index</a><a href=\"#\" aria-current=\"page\">The portal run</a><a href=\"#\">The dataset</a><a href=\"#\">Ask the assistant</a><a href=\"#\">Rules vs AI</a></nav>",
      "css": ".ds-nav{display:inline-flex;gap:2px;padding:4px;border-radius:999px;background:var(--card,#fff);box-shadow:0 1px 2px rgba(16,20,26,.05),0 6px 20px -8px rgba(16,20,26,.12);font:.82rem \"Segoe UI Variable Text\",system-ui,sans-serif}.ds-nav a{color:var(--ink-2,#4d5560);text-decoration:none;padding:5px 13px;border-radius:999px;transition:background .15s,color .15s}.ds-nav a:hover{color:var(--ink,#121417);background:var(--card-2,#f0f2f5)}.ds-nav a:focus-visible{outline:2px solid var(--ours,#266ec4);outline-offset:2px}.ds-nav a[aria-current=page]{color:var(--bg,#f3f4f6);background:var(--ink,#121417);font-weight:650}"
    },
    {
      "name": "Stepper",
      "kind": "custom",
      "refersTo": "step",
      "description": "Pill tabs with numbered circles; selected inverts, visited turns green.",
      "html": "<div class=\"ds-steps\" role=\"tablist\"><button class=\"ds-step ds-seen\" role=\"tab\"><span class=\"ds-n\">1</span>The portal</button><button class=\"ds-step\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-n\">2</span>Discovery</button><button class=\"ds-step\" role=\"tab\"><span class=\"ds-n\">3</span>The crawl</button></div>",
      "css": ".ds-steps{display:flex;gap:6px;padding:2px}.ds-step{font:600 .92rem \"Segoe UI Variable Text\",system-ui,sans-serif;background:var(--card,#fff);border:none;border-radius:999px;padding:8px 14px 8px 8px;color:var(--ink-2,#4d5560);cursor:pointer;display:inline-flex;gap:9px;align-items:center;box-shadow:0 1px 2px rgba(16,20,26,.05),0 6px 20px -8px rgba(16,20,26,.12);transition:background .2s,color .2s,transform .15s}.ds-step:hover{transform:translateY(-1px);color:var(--ink,#121417)}.ds-step:focus-visible{outline:2px solid var(--ours,#266ec4);outline-offset:2px}.ds-n{display:inline-grid;place-items:center;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--card-2,#f0f2f5);font-size:.8rem;font-weight:750}.ds-step[aria-selected=true]{background:var(--ink,#121417);color:var(--bg,#f3f4f6)}.ds-step[aria-selected=true] .ds-n{background:var(--bg,#f3f4f6);color:var(--ink,#121417)}.ds-seen .ds-n{background:var(--good-bg,#e1f4e9);color:var(--good,#187d43)}"
    },
    {
