      "css": ".ds-term{margin:0;font-family:ui-monospace,\"Cascadia Mono\",Consolas,monospace;font-size:.8rem;background:#0d1014;color:#d7dde3;border-radius:8px;padding:7px 10px;overflow-x:auto}"
